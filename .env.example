# Copy to .env and change the secrets before running anywhere but your own machine.
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=weave
COOKIE_SECURE=false
# Let the LaTeX compiler download packages that aren't in the pre-warmed cache.
# false = the compile container has no internet access at all (safer, see docs/ARCHITECTURE.md).
COMPILE_ALLOW_NETWORK=false
